# ── Database (Neon Postgres) ──────────────────────────────────────────────────
# Get from Vercel Dashboard → Storage → Neon → Connect → .env.local tab
# OR from neon.tech dashboard → your project → Connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Generate a strong random value: openssl rand -base64 32
JWT_SECRET="your-strong-random-secret-min-32-chars"

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email address that gets admin dashboard access
ADMIN_EMAIL="your-admin@email.com"

# ── Resend (Email OTP Verification) ───────────────────────────────────────────
# Free tier: 3,000 emails/month — sign up at https://resend.com
# Get API key from: Resend Dashboard → API Keys → Create API Key
RESEND_API_KEY="re_YOUR_RESEND_API_KEY_HERE"
# Sender address — use onboarding@resend.dev for testing (only sends to your own email)
# For production, verify your domain at resend.com/domains
RESEND_FROM_EMAIL="FitCheck <onboarding@resend.dev>"

# ── Stripe (Payments) ─────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
# Use sk_test_... for testing, sk_live_... for production
STRIPE_SECRET_KEY="sk_live_YOUR_STRIPE_SECRET_KEY_HERE"

# ── App URL ───────────────────────────────────────────────────────────────────
# Your FRONTEND Vercel deployment URL — used for Stripe success/cancel redirects
APP_URL="https://your-fitcheck-frontend.vercel.app"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="https://your-fitcheck-frontend.vercel.app"
